# Telegram AI 1: notifications + polling
TELEGRAM_BOT_TOKEN=123456789:YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=-1001234567890
# Required to accept modifying commands; comma-separated Telegram numeric user IDs
TELEGRAM_ADMIN_IDS=123456789

TZ=Asia/Ho_Chi_Minh
# demo | file | http. Demo is never actionable.
DATA_MODE=demo
SNAPSHOT_FILE=data/snapshot.json
MARKET_DATA_URL=
MARKET_DATA_TOKEN=
# Separate read-only quote endpoint; optional
QUOTE_URL=

# Review official holiday calendar and set true before allowing real-data BUY_ZONE
CALENDAR_VERIFIED=false
# Keep false until fees are verified against your account
FEES_VERIFIED=false
# Enable experimental reversal entry only after separate validation
REVERSAL_ENABLED=false
# Set true after strategy validation; otherwise research-only
STRATEGIES_APPROVED=false
STATE_FILE=data/state.json

# Optional HTTP healthcheck port (automatically provided by Render)
PORT=3000
